{{define "content"}}
<section class="pt-2">
  <nav aria-label="breadcrumb">
    <ol class="breadcrumb">
      <li class="breadcrumb-item active" aria-current="page">Administration</li>
      <li class="breadcrumb-item"><a href="/admin/users">Users</a></li>
      <li class="breadcrumb-item active" aria-current="page">Delete user</li>
    </ol>
  </nav>

  <h2 class="h3">Delete user - {{.Email}}</h2>

  {{template "userDeleteForm" (dict "User" . "InModal" false)}}
</section>
{{end}}

{{/* InModal enables htmx attributes; only true when loaded into the user list page's delete modal. */}}
{{define "userDeleteForm"}}
<p class="mb-4">
  Delete user <strong>{{.User.Email}}</strong> and all associated data?
</p>

<form action="/admin/users/{{.User.UUID}}/delete" method="POST"
  {{if .InModal}}hx-post="/admin/users/{{.User.UUID}}/delete" hx-target="this" hx-swap="outerHTML"{{end}}>
  <button type="submit" class="btn btn-danger">Delete</button>
</form>
{{end}}
