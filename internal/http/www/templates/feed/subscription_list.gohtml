{{define "content"}}
<section class="pt-2 container-fluid">
  <nav aria-label="breadcrumb">
    <ol class="breadcrumb">
      <li class="breadcrumb-item"><a href="/feeds">Feeds</a></li>
      <li class="breadcrumb-item active" aria-current="page">Subscriptions</li>
    </ol>
  </nav>

  <div class="row">
    {{- range .}}
    <div class="col-12 col-md-6 col-lg-4 mb-3" id="category-column-{{.UUID}}">
      <div class="card">
        {{template "categoryHeading" .}}
        <ul class="list-group list-group-flush">
          {{- range .Subscriptions}}
          {{template "subscriptionRow" .}}
          {{- end}}
        </ul>
      </div>
    </div>
    {{- end}}
  </div>

  <div class="modal fade" id="categoryEditModal" tabindex="-1" aria-labelledby="categoryEditModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg">
      <div class="modal-content">
        <div class="modal-header">
          <h5 class="modal-title" id="categoryEditModalLabel">Edit category</h5>
          <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
        </div>
        <div class="modal-body" id="category-edit-modal-body"></div>
      </div>
    </div>
  </div>

  <div class="modal fade" id="subscriptionEditModal" tabindex="-1" aria-labelledby="subscriptionEditModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg">
      <div class="modal-content">
        <div class="modal-header">
          <h5 class="modal-title" id="subscriptionEditModalLabel">Edit subscription</h5>
          <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
        </div>
        <div class="modal-body" id="subscription-edit-modal-body"></div>
      </div>
    </div>
  </div>

  <div class="modal fade" id="categoryDeleteModal" tabindex="-1" aria-labelledby="categoryDeleteModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg">
      <div class="modal-content">
        <div class="modal-header">
          <h5 class="modal-title" id="categoryDeleteModalLabel">Delete category</h5>
          <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
        </div>
        <div class="modal-body" id="category-delete-modal-body"></div>
      </div>
    </div>
  </div>

  <div class="modal fade" id="subscriptionDeleteModal" tabindex="-1" aria-labelledby="subscriptionDeleteModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg">
      <div class="modal-content">
        <div class="modal-header">
          <h5 class="modal-title" id="subscriptionDeleteModalLabel">Delete subscription</h5>
          <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
        </div>
        <div class="modal-body" id="subscription-delete-modal-body"></div>
      </div>
    </div>
  </div>
</section>
{{end}}

{{define "categoryHeading"}}
<div class="card-header d-flex justify-content-between align-items-center" id="category-{{.UUID}}">
  <span>{{.Name}} ({{len .Subscriptions}})</span>
  <div class="btn-group">
    <a class="btn btn-sm bg-info-subtle text-info-emphasis border-0" href="/feeds/categories/{{.UUID}}/edit"
      title="Edit category: {{.Name}}"
      hx-get="/feeds/categories/{{.UUID}}/edit" hx-target="#category-edit-modal-body" hx-swap="innerHTML">
      <i class="fa-solid fa-pen-to-square"></i>
    </a>
    <a class="btn btn-sm bg-danger-subtle text-danger-emphasis border-0" href="/feeds/categories/{{.UUID}}/delete"
      title="Delete category: {{.Name}}"
      hx-get="/feeds/categories/{{.UUID}}/delete" hx-target="#category-delete-modal-body" hx-swap="innerHTML">
      <i class="fa-solid fa-trash"></i>
    </a>
  </div>
</div>
{{end}}

{{define "subscriptionRow"}}
<li class="list-group-item d-flex justify-content-between align-items-center" id="subscription-{{.UUID}}">
  <span>
    <i class="fa-solid fa-rss me-1"></i>
    {{or .Alias .FeedTitle}}
  </span>
  <div class="btn-group">
    <a class="btn btn-sm bg-info-subtle text-info-emphasis border-0" href="/feeds/subscriptions/{{.UUID}}/edit"
      title="Edit subscription: {{.FeedTitle}}"
      hx-get="/feeds/subscriptions/{{.UUID}}/edit" hx-target="#subscription-edit-modal-body" hx-swap="innerHTML">
      <i class="fa-solid fa-pen-to-square"></i>
    </a>
    <a class="btn btn-sm bg-danger-subtle text-danger-emphasis border-0" href="/feeds/subscriptions/{{.UUID}}/delete"
      title="Delete subscription: {{.FeedTitle}}"
      hx-get="/feeds/subscriptions/{{.UUID}}/delete" hx-target="#subscription-delete-modal-body" hx-swap="innerHTML">
      <i class="fa-solid fa-trash"></i>
    </a>
  </div>
</li>
{{end}}
