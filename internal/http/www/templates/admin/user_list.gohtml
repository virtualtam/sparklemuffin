{{define "content"}}
<section class="pt-3">
  <nav aria-label="breadcrumb">
    <ol class="breadcrumb">
      <li class="breadcrumb-item active" aria-current="page">Administration</li>
      <li class="breadcrumb-item active" aria-current="page">Users</li>
    </ol>
  </nav>

  {{template "userTable" .}}

  <div class="modal fade" id="userDeleteModal" tabindex="-1" aria-labelledby="userDeleteModalLabel" aria-hidden="true">
    <div class="modal-dialog">
      <div class="modal-content">
        <div class="modal-header">
          <h5 class="modal-title" id="userDeleteModalLabel">Delete user</h5>
          <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
        </div>
        <div class="modal-body" id="user-delete-modal-body"></div>
      </div>
    </div>
  </div>
</section>
{{end}}

{{define "userTable"}}
<table class="table table-striped table-hover">
  <thead>
    <tr>
      <th>Email</th>
      <th>Nickname</th>
      <th>Display Name</th>
      <th>Is Admin?</th>
      <th>Actions</th>
    </tr>
  </thead>
  <tbody>
    {{range .}}
    {{template "userRow" .}}
    {{end}}
  </tbody>
</table>
{{end}}

{{define "userRow"}}
<tr id="user-row-{{.UUID}}">
  <td>{{.Email}}</td>
  <td>{{.NickName}}</td>
  <td>{{.DisplayName}}</td>
  <td>{{if .IsAdmin}}yes{{else}}no{{end}}</td>
  <td>
    <a href="/admin/users/{{.UUID}}" title="Edit user">
      <i class="fa-solid fa-pen-to-square"></i>
    </a>
    <a class="text-danger" href="/admin/users/{{.UUID}}/delete" title="Delete user"
      hx-get="/admin/users/{{.UUID}}/delete" hx-target="#user-delete-modal-body" hx-swap="innerHTML"
      data-bs-toggle="modal" data-bs-target="#userDeleteModal">
      <i class="fa-solid fa-trash"></i>
    </a>
  </td>
</tr>
{{end}}
