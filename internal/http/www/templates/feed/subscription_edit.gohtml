{{define "content"}}
<section class="pt-2 container-fluid">
  <nav aria-label="breadcrumb">
    <ol class="breadcrumb">
      <li class="breadcrumb-item"><a href="/feeds">Feeds</a></li>
      <li class="breadcrumb-item"><a href="/feeds/subscriptions">Subscriptions</a></li>
      <li class="breadcrumb-item active" aria-current="page">Edit</li>
    </ol>
  </nav>

  {{template "subscriptionEditForm" (dict "Subscription" .Subscription "Categories" .Categories "InModal" false)}}
</section>
{{end}}

{{/* InModal enables htmx attributes; only true when loaded into the subscriptions page's edit modal. */}}
{{define "subscriptionEditForm"}}
<form action="/feeds/subscriptions/{{.Subscription.UUID}}/edit" method="POST"
  {{if .InModal}}hx-post="/feeds/subscriptions/{{.Subscription.UUID}}/edit" hx-target="this" hx-swap="outerHTML"{{end}}>
  <div class="row mb-3">
    <label class="col-sm-2 col-form-label" for="title">Title</label>
    <div class="col-sm-10 pt-2">{{.Subscription.FeedTitle}}</div>
  </div>

  <div class="row mb-3">
    <label class="col-sm-2 col-form-label" for="alias">Alias</label>
    <div class="col-sm-10">
      <input class="form-control" type="text" id="alias" name="alias"
        placeholder="An optional alias to be displayed instead of the feed title" value="{{.Subscription.Alias}}">
    </div>
  </div>

  <div class="row mb-3">
    <label class="col-sm-2 col-form-label" for="description">Description</label>
    <div class="col-sm-10 pt-2">
      <span id="description">{{.Subscription.FeedDescription}}</span>
    </div>
  </div>

  <div class="row mb-3">
    <label class="col-sm-2 col-form-label" for="category">Category</label>
    <div class="col-sm-10">
      <select class="form-select" name="category" id="category">
        {{- range .Categories}}
        <option value="{{.UUID}}" {{if eq .UUID $.Subscription.CategoryUUID}} selected{{end}}>{{.Name}}</option>
        {{- end}}
      </select>
    </div>
  </div>

  <div class="row mb-3">
    <div class="col-sm-10 offset-sm-2">
      <button type="submit" class="btn btn-primary">Save</button>
    </div>
  </div>
</form>
{{end}}
