{{define "content"}}
<section class="pt-2 container-fluid" id="bookmark-list-content">
  {{template "bookmarkSearchForm" .}}
  <ol start="{{.Page.ItemOffset}}">
    {{range .Bookmarks}}
    {{template "bookmarkRow" (dict "Bookmark" . "Owner" $.Owner "Public" false)}}
    {{end}}
  </ol>
  <nav class="d-flex justify-content-between align-items-center">
    <a href="#bookmark-list-content" class="btn btn-outline-secondary btn-sm">
      <i class="fa-solid fa-chevron-up me-1"></i>
      Back to top
    </a>
    {{template "pagination" (dict "Page" .Page "HxTarget" "#bookmark-list-content")}}
  </nav>

  <div class="modal modal-wide fade" id="bookmarkEditModal" tabindex="-1" aria-labelledby="bookmarkEditModalLabel"
       aria-hidden="true">
    <div class="modal-dialog">
      <div class="modal-content">
        <div class="modal-header">
          <h5 class="modal-title" id="bookmarkEditModalLabel">Edit bookmark</h5>
          <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
        </div>
        <div class="modal-body" id="bookmark-edit-modal-body"></div>
      </div>
    </div>
  </div>

  <div class="modal fade" id="bookmarkDeleteModal" tabindex="-1" aria-labelledby="bookmarkDeleteModalLabel"
       aria-hidden="true">
    <div class="modal-dialog modal-lg">
      <div class="modal-content">
        <div class="modal-header">
          <h5 class="modal-title" id="bookmarkDeleteModalLabel">Delete bookmark</h5>
          <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
        </div>
        <div class="modal-body" id="bookmark-delete-modal-body"></div>
      </div>
    </div>
  </div>
</section>
{{end}}

{{define "bookmarkSearchForm"}}
<nav class="d-flex justify-content-between align-items-center mb-3">
  <div class="d-flex align-items-center gap-3 list-header-offset">
    <form action="/bookmarks" method="GET"
      hx-get="/bookmarks" hx-target="#bookmark-list-content" hx-swap="outerHTML" hx-push-url="true">
      <div class="input-group input-group-sm">
        <input class="form-control" type="text" id="searchTerms" name="search" placeholder="Search terms"
               value="{{.Page.SearchTerms}}">
        <button type="submit" class="btn btn-outline-secondary">
          <i class="fa-solid fa-magnifying-glass me-1"></i>
          Search
        </button>
      </div>
    </form>
    <p class="fs-5 mb-0">
      {{if ne .Page.SearchTerms "" }}
      <strong>{{.Page.ItemCount}}</strong> bookmark{{if gt .Page.ItemCount 1}}s{{end}} found
      {{else}}
      <strong>{{.Page.ItemCount}}</strong> bookmark{{if gt .Page.ItemCount 1}}s{{end}}
      {{end}}
    </p>
  </div>
  {{template "pagination" (dict "Page" .Page "HxTarget" "#bookmark-list-content")}}
</nav>
{{end}}

{{define "scripts"}}
  <script nonce="{{.Nonce}}" src="/static/complete-tags.min.js"></script>
  <script nonce="{{.Nonce}}" src="/static/easymde-init.min.js"></script>
{{end}}
