{{define "content"}}
<section id="tag-list-content" class="pt-3">
  <nav aria-label="breadcrumb">
    <ol class="breadcrumb">
      <li class="breadcrumb-item"><a href="/bookmarks">Bookmarks</a></li>
      <li class="breadcrumb-item active" aria-current="page">Tags</li>
    </ol>
  </nav>

  {{template "tagFilterForm" .}}

  <div class="row">
    {{- range $i, $tag := .Tags}}
    {{- if eq (mod $i 30) 0 }}
    {{- if ne $i 0 }}</div>{{end}}
  <div class="col-12 col-md-6 col-lg-4">
    {{- end}}
    {{template "tagRow" $tag}}
    {{- end}}
  </div>
  </div>
  <nav class="d-flex justify-content-between align-items-center">
    <a href="#tag-list-content" class="btn btn-outline-secondary btn-sm">
      <i class="fa-solid fa-chevron-up me-1"></i>
      Back to top
    </a>
    {{template "pagination" (dict "Page" .Page "HxTarget" "#tag-list-content")}}
  </nav>

  <div class="modal fade" id="tagEditModal" tabindex="-1" aria-labelledby="tagEditModalLabel" aria-hidden="true">
    <div class="modal-dialog">
      <div class="modal-content">
        <div class="modal-header">
          <h5 class="modal-title" id="tagEditModalLabel">Edit tag</h5>
          <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
        </div>
        <div class="modal-body" id="tag-edit-modal-body"></div>
      </div>
    </div>
  </div>

  <div class="modal fade" id="tagDeleteModal" tabindex="-1" aria-labelledby="tagDeleteModalLabel" aria-hidden="true">
    <div class="modal-dialog">
      <div class="modal-content">
        <div class="modal-header">
          <h5 class="modal-title" id="tagDeleteModalLabel">Delete tag</h5>
          <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
        </div>
        <div class="modal-body" id="tag-delete-modal-body"></div>
      </div>
    </div>
  </div>
</section>
{{end}}

{{define "tagRow"}}
<div class="d-flex justify-content-between align-items-center" id="tag-row-{{.EncodedName}}">
  <div class="d-flex align-items-center gap-2">
    <span class="badge text-bg-light tag-count">{{.Count}}</span>
    <a href="/bookmarks?search={{.Name}}" title="Bookmarks tagged {{.Name}}">
      <i class="fa-solid fa-tag me-1"></i>
      {{.Name}}
    </a>
  </div>
  <div class="btn-group">
    <a class="btn btn-sm btn-outline-info" href="/bookmarks/tags/{{.EncodedName}}/edit"
      title="Edit tag: {{.Name}}"
      hx-get="/bookmarks/tags/{{.EncodedName}}/edit" hx-target="#tag-edit-modal-body" hx-swap="innerHTML"
      data-bs-toggle="modal" data-bs-target="#tagEditModal">
      <i class="fa-solid fa-pen-to-square"></i>
    </a>
    <a class="btn btn-sm btn-outline-danger" href="/bookmarks/tags/{{.EncodedName}}/delete"
      title="Delete tag: {{.Name}}"
      hx-get="/bookmarks/tags/{{.EncodedName}}/delete" hx-target="#tag-delete-modal-body" hx-swap="innerHTML"
      data-bs-toggle="modal" data-bs-target="#tagDeleteModal">
      <i class="fa-solid fa-trash"></i>
    </a>
  </div>
</div>
{{end}}

{{define "tagFilterForm"}}
<nav class="d-flex justify-content-between align-items-center mb-3">
  <form action="/bookmarks/tags" method="GET"
    hx-get="/bookmarks/tags" hx-target="#tag-list-content" hx-swap="outerHTML" hx-push-url="true">
    <div class="input-group">
      <input class="form-control" type="text" id="filterTerm" name="search" placeholder="Filter by name"
        value="{{.Page.SearchTerms}}">
      <button type="submit" class="btn btn-outline-secondary">
        <i class="fa-solid fa-filter me-1"></i>
        Filter
      </button>
    </div>
  </form>
</nav>
{{end}}
