{{define "content"}}
<section class="pt-2">
  <nav aria-label="breadcrumb">
    <ol class="breadcrumb">
      <li class="breadcrumb-item"><a href="/bookmarks">Bookmarks</a></li>
      <li class="breadcrumb-item"><a href="/bookmarks/tags">Tags</a></li>
      <li class="breadcrumb-item active" aria-current="page">Delete</li>
    </ol>
  </nav>

  {{template "tagDeleteForm" (dict "Tag" . "InModal" false)}}
</section>
{{end}}

{{/* InModal enables htmx attributes; only true when loaded into the tag list page's delete modal. */}}
{{define "tagDeleteForm"}}
<p class="mb-4">Delete tag: <span class="badge bg-secondary-subtle text-secondary-emphasis">{{.Tag.Name}}</span>?</p>

<form action="/bookmarks/tags/{{.Tag.EncodedName}}/delete" method="POST"
  {{if .InModal}}hx-post="/bookmarks/tags/{{.Tag.EncodedName}}/delete" hx-target="this" hx-swap="outerHTML"{{end}}>
  <button type="submit" class="btn btn-danger">Delete</button>
</form>
{{end}}
