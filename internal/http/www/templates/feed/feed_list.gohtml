{{define "content"}}
<section class="pt-2 container-fluid g-5 g-lg-3">
  <div class="row g-5 g-lg-3">
    <div class="col-12 col-lg-3">
      <aside x-data="feedMenu()" x-init="loadState()">
        <p class="d-flex justify-content-between align-items-center mb-1">
          <a class="link-body-emphasis link-underline-opacity-0 link-underline-opacity-100-hover" href="/feeds"
            hx-get="/feeds" hx-target="#feed-list-content" hx-swap="outerHTML" hx-push-url="true">
            <span class="fw-semibold">All</span>
          </a>
          {{template "unreadCountAll" .Unread}}
        </p>
        <hr class="my-1">

        {{- range .Categories}}
          <p class="d-flex justify-content-between align-items-center mb-1">
            <span class="d-flex align-items-center gap-1 fw-semibold">
              <span class="feed-category-toggle" tabindex="0" role="button"
                aria-controls="feed-category-{{.Slug}}" aria-label="Toggle category: {{.Name}}"
                :aria-expanded="(!!open['{{.Slug}}']).toString()"
                @click.stop="toggleCategory('{{.Slug}}')"
                @keydown.enter.stop="toggleCategory('{{.Slug}}')"
                @keydown.space.stop.prevent="toggleCategory('{{.Slug}}')">
                <i class="fa-regular" :class="open['{{.Slug}}'] ? 'fa-square-minus' : 'fa-square-plus'"></i>
              </span>
              <a class="link-body-emphasis link-underline-opacity-0 link-underline-opacity-100-hover" href="/feeds/categories/{{.Slug}}"
                hx-get="/feeds/categories/{{.Slug}}" hx-target="#feed-list-content" hx-swap="outerHTML" hx-push-url="true">{{.Name}}</a>
            </span>
            {{template "unreadCountCategory" .}}
          </p>
          <ul class="list-unstyled ps-3" id="feed-category-{{.Slug}}" x-cloak x-show="open['{{.Slug}}']">
            {{- range .SubscribedFeeds}}
              <li class="d-flex justify-content-between align-items-center">
                <a class="link-body-emphasis link-underline-opacity-0 link-underline-opacity-100-hover" href="/feeds/subscriptions/{{.Slug}}"
                  hx-get="/feeds/subscriptions/{{.Slug}}" hx-target="#feed-list-content" hx-swap="outerHTML" hx-push-url="true">{{or .Alias .Title}}</a>
                {{template "unreadCountFeed" .}}
              </li>
            {{- end}}
          </ul>
        {{- end}}
      </aside>
    </div>

    {{template "feedListContent" .}}
  </div>
  <nav class="d-flex justify-content-between align-items-center">
    <a href="#feed-list-content" class="btn btn-outline-secondary btn-sm">
      <i class="fa-solid fa-chevron-up me-1"></i>
      Back to top
    </a>
    {{template "paginationBottom" .Page}}
  </nav>
</section>
{{end}}

{{define "feedListContent"}}
<div class="col-12 col-lg-9" id="feed-list-content">
  <div class="d-flex justify-content-between align-items-center mb-3">
    <h2 class="h4 mb-0 list-header-offset">{{.PageTitle}}</h2>
    <div class="d-flex align-items-center gap-2">
      {{template "showEntriesButtons" (dict
        "ShowEntries" .Preferences.ShowEntries
        "URLPath" .URLPath
        "SearchTerms" .Page.SearchTerms
      )}}
      {{template "compactButton" (dict
        "ShowEntrySummaries" .Preferences.ShowEntrySummaries
        "URLPath" .URLPath
        "SearchTerms" .Page.SearchTerms
        "PageNumber" .Page.PageNumber
      )}}
      <div class="btn-group">
        <button
          title="Mark all entries as read"
          class="btn btn-sm btn-outline-secondary"
          hx-post="{{.URLPath}}/entries/mark-all-read"
          hx-target="#entry-list"
          hx-swap="outerHTML"
          hx-vals='{{toJSON "urlPath" .URLPath "search" .Page.SearchTerms}}'
        >
          <i class="fa-solid fa-eye-slash me-1"></i>
          Mark all as read
        </button>
      </div>
    </div>
  </div>

  {{with .Description}}
  <h3 class="h6 text-muted list-header-offset">{{.}}</h3>
  {{end}}

  {{template "feedSearchForm" .}}

  {{template "entryList" (dict
    "Entries" .Entries
    "ItemOffset" .Page.ItemOffset
    "ShowEntrySummaries" .Preferences.ShowEntrySummaries
    "URLPath" .URLPath
    "SearchTerms" .Page.SearchTerms
    "PageNumber" .Page.PageNumber
  )}}
</div>
{{end}}

{{define "scripts"}}
<script nonce="{{.Nonce}}">
  function feedMenu() {
    return {
      open: {},

      loadState() {
        const saved = localStorage.getItem('feedMenuState');
        this.open = saved ? JSON.parse(saved) : {};
      },

      saveState() {
        localStorage.setItem('feedMenuState', JSON.stringify(this.open));
      },

      toggleCategory(key) {
        this.open[key] = !this.open[key];
        this.saveState();
      },
    };
  }
</script>
{{end}}

{{define "feedSearchForm"}}
<nav class="d-flex justify-content-between align-items-center mb-3">
  <div class="d-flex align-items-center gap-3 list-header-offset">
    <form action="{{.URLPath}}" method="GET"
      hx-get="{{.URLPath}}" hx-target="#feed-list-content" hx-swap="outerHTML" hx-push-url="true">
      <div class="input-group input-group-sm">
        <input class="form-control" type="text" id="searchTerms" name="search" placeholder="Search terms"
          value="{{.SearchTerms}}">
        <button class="btn btn-outline-secondary" type="submit">
          <i class="fa-solid fa-magnifying-glass me-1"></i>
          Search
        </button>
      </div>
    </form>
    {{template "entryCount" .Page}}
  </div>
  {{template "paginationTop" .Page}}
</nav>
{{end}}

{{define "entryList"}}
<ol id="entry-list" start="{{.ItemOffset}}">
  {{- range .Entries}}
    {{template "feedEntry" (dict
      "Entry" .
      "ShowEntrySummaries" $.ShowEntrySummaries
      "URLPath" $.URLPath
      "SearchTerms" $.SearchTerms
      "PageNumber" $.PageNumber
    )}}
  {{- end}}
</ol>
{{end}}

{{define "feedEntry"}}
<li class="mb-4" id="feed-entry-{{.Entry.UID}}">
  <div class="d-flex justify-content-between align-items-center mb-1">
    <strong><a class="link-body-emphasis link-underline-opacity-0 link-underline-opacity-100-hover{{if .Entry.Read}} text-muted{{end}}"
        href="{{.Entry.URL}}">{{.Entry.Title}}</a></strong>
    <strong>
      <time class="{{if .Entry.Read}}text-muted{{end}}">{{.Entry.PublishedAt.Format "2006-01-02"}}</time>
    </strong>
  </div>
  <div class="d-flex justify-content-between align-items-center mb-1">
    <div class="{{if .Entry.Read}}text-muted{{end}}">
      <i class="fa-regular fa-newspaper me-1"></i>
      <span class="fw-light">
        <a class="fst-italic link-body-emphasis link-underline-opacity-0 link-underline-opacity-100-hover{{if .Entry.Read}} text-muted{{end}}" href="/feeds/subscriptions/{{.Entry.FeedSlug}}">{{ or .Entry.SubscriptionAlias .Entry.FeedTitle }}</a>
      </span>
    </div>
    <button
      type="button"
      class="btn btn-sm btn-outline-secondary"
      hx-post="/feeds/entries/{{.Entry.UID}}/toggle-read"
      hx-target="#feed-entry-{{.Entry.UID}}"
      hx-swap="outerHTML"
      hx-vals='{{toJSON "urlPath" .URLPath "search" .SearchTerms "page" .PageNumber}}'
    >
      {{if .Entry.Read}}
      <i class="fa-solid fa-eye-slash me-1"></i>
      Mark as unread
      {{else}}
      <i class="fa-solid fa-eye me-1"></i>
      Mark as read
      {{end}}
    </button>
  </div>

  <div class="{{if .Entry.Read}}text-muted{{end}}">
    {{- if .ShowEntrySummaries}}
      {{- with .Entry.Summary }}
      <div class="content">{{.}}</div>
      {{- end}}
    {{- end}}
  </div>
</li>
{{end}}

{{define "unreadCountAll"}}<span id="unread-count-all" class="badge bg-secondary-subtle text-secondary-emphasis" hx-swap-oob="true">{{.}}</span>{{end}}

{{define "unreadCountCategory"}}<span id="unread-count-category-{{.Slug}}" class="badge bg-secondary-subtle text-secondary-emphasis" hx-swap-oob="true">{{.Unread}}</span>{{end}}

{{define "unreadCountFeed"}}<span id="unread-count-feed-{{.Slug}}" class="badge bg-secondary-subtle text-secondary-emphasis" hx-swap-oob="true">{{.Unread}}</span>{{end}}

{{define "entryCount"}}
<p id="entry-count" class="fs-5 mb-0" hx-swap-oob="true">
  {{if ne .SearchTerms "" }}
  <strong>{{.ItemCount}}</strong> entr{{if gt .ItemCount 1}}ies{{else}}y{{end}} found
  {{else}}
  <strong>{{.ItemCount}}</strong> entr{{if gt .ItemCount 1}}ies{{else}}y{{end}}
  {{end}}
</p>
{{end}}

{{define "showEntriesButtons"}}
<div class="btn-group" id="show-entries-buttons" hx-swap-oob="true">
  <button
    title="Show all entries"
    class="btn btn-sm btn-outline-secondary{{if eq .ShowEntries "ALL"}} active{{end}}"
    hx-post="/feeds/preferences/show-entries"
    hx-target="#entry-list"
    hx-swap="outerHTML"
    hx-vals='{{toJSON "show" "ALL" "urlPath" .URLPath "search" .SearchTerms}}'
  >
    <i class="fa-solid fa-globe me-1"></i>
    All
  </button>

  <button
    title="Show only read entries"
    class="btn btn-sm btn-outline-secondary{{if eq .ShowEntries "READ"}} active{{end}}"
    hx-post="/feeds/preferences/show-entries"
    hx-target="#entry-list"
    hx-swap="outerHTML"
    hx-vals='{{toJSON "show" "READ" "urlPath" .URLPath "search" .SearchTerms}}'
  >
    <i class="fa-solid fa-check-circle me-1"></i>
    Read
  </button>

  <button
    title="Show only unread entries"
    class="btn btn-sm btn-outline-secondary{{if eq .ShowEntries "UNREAD"}} active{{end}}"
    hx-post="/feeds/preferences/show-entries"
    hx-target="#entry-list"
    hx-swap="outerHTML"
    hx-vals='{{toJSON "show" "UNREAD" "urlPath" .URLPath "search" .SearchTerms}}'
  >
    <i class="fa-solid fa-envelope me-1"></i>
    Unread
  </button>
</div>
{{end}}

{{define "compactButton"}}
<div class="btn-group" id="compact-button" hx-swap-oob="true">
  <button
    title="Show or hide entry summaries"
    class="btn btn-sm btn-outline-secondary{{if eq .ShowEntrySummaries false}} active{{end}}"
    hx-post="/feeds/preferences/toggle-show-entry-summaries"
    hx-target="#entry-list"
    hx-swap="outerHTML"
    hx-vals='{{toJSON "urlPath" .URLPath "search" .SearchTerms "page" .PageNumber}}'
  >
    <i class="fa-regular fa-rectangle-list me-1"></i>
    Compact
  </button>
</div>
{{end}}

{{define "paginationTop"}}<div id="pagination-top" hx-swap-oob="true">{{template "pagination" (dict "Page" . "HxTarget" "#feed-list-content")}}</div>{{end}}

{{define "paginationBottom"}}<div id="pagination-bottom" hx-swap-oob="true">{{template "pagination" (dict "Page" . "HxTarget" "#feed-list-content")}}</div>{{end}}
