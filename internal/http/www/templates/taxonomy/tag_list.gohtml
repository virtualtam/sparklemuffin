{{define "content"}}
<section id="tag-list-content" class="pt-2 container-fluid">
  <nav aria-label="breadcrumb">
    <ol class="breadcrumb">
      <li class="breadcrumb-item active" aria-current="page">Tags</li>
    </ol>
  </nav>

  {{template "tagFilterForm" .}}

  <div class="row">
    {{- range $i, $tag := .Tags}}
    {{- if eq (mod $i 30) 0 }}
    {{- if ne $i 0 }}</div>{{end}}
  <div class="col-12 col-md-6">
    {{- end}}
    {{template "tagRow" $tag}}
    {{- end}}
  </div>
  </div>
  <nav class="d-flex justify-content-between align-items-center">
    <a href="#tag-list-content" class="btn btn-outline-secondary btn-sm">
      <i class="fa-solid fa-chevron-up me-1"></i>
      Back to top
    </a>
    {{template "pagination" (dict "Page" .Page "HxTarget" "#tag-list-content")}}
  </nav>

  <div class="modal fade" id="tagEditModal" tabindex="-1" aria-labelledby="tagEditModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg">
      <div class="modal-content">
        <div class="modal-header">
          <h5 class="modal-title" id="tagEditModalLabel">Edit tag</h5>
          <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
        </div>
        <div class="modal-body" id="tag-edit-modal-body"></div>
      </div>
    </div>
  </div>

  <div class="modal fade" id="tagDeleteModal" tabindex="-1" aria-labelledby="tagDeleteModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg">
      <div class="modal-content">
        <div class="modal-header">
          <h5 class="modal-title" id="tagDeleteModalLabel">Delete tag</h5>
          <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
        </div>
        <div class="modal-body" id="tag-delete-modal-body"></div>
      </div>
    </div>
  </div>
</section>
{{end}}

{{define "tagRow"}}
<div class="tag-row d-flex justify-content-between align-items-center mb-2" id="tag-row-{{.UUID}}">
  <div class="d-flex align-items-center gap-2">
    <span class="badge bg-secondary-subtle text-secondary-emphasis tag-count" title="Bookmarks tagged {{.Name}}">
      <i class="fa-regular fa-bookmark me-1"></i>
      {{.BookmarkCount}}
    </span>
    <span class="badge bg-secondary-subtle text-secondary-emphasis tag-count" title="Feed subscriptions tagged {{.Name}}">
      <i class="fa-regular fa-newspaper me-1"></i>
      {{.FeedCount}}
    </span>
    <span class="badge bg-secondary-subtle text-secondary-emphasis">
      <i class="fa-solid fa-tag me-1"></i>
      {{.Name}}
    </span>
  </div>
  <div class="btn-group">
    <a class="btn btn-xs btn-subtle-info" href="/tags/{{.UUID}}/edit"
      title="Edit tag: {{.Name}}"
      hx-get="/tags/{{.UUID}}/edit" hx-target="#tag-edit-modal-body" hx-swap="innerHTML">
      <i class="fa-solid fa-pen-to-square"></i>
      <span class="visually-hidden">Edit tag: {{.Name}}</span>
    </a>
    <a class="btn btn-xs btn-subtle-danger" href="/tags/{{.UUID}}/delete"
      title="Delete tag: {{.Name}}"
      hx-get="/tags/{{.UUID}}/delete" hx-target="#tag-delete-modal-body" hx-swap="innerHTML">
      <i class="fa-solid fa-trash"></i>
      <span class="visually-hidden">Delete tag: {{.Name}}</span>
    </a>
  </div>
</div>
{{end}}

{{define "tagFilterForm"}}
<nav class="d-flex justify-content-between align-items-center mb-3">
  <div class="d-flex align-items-center gap-3">
    <form action="/tags" method="GET"
      hx-get="/tags" hx-target="#tag-list-content" hx-swap="outerHTML" hx-push-url="true">
      <div class="input-group input-group-sm search-form">
        <input class="form-control" type="text" id="filterTerm" name="search" placeholder="Filter by name"
          value="{{.Page.SearchTerms}}">
        <button type="submit" class="btn btn-outline-secondary">
          <i class="fa-solid fa-filter me-1"></i>
          Filter
        </button>
      </div>
    </form>
    <p class="fs-5 mb-0">
      {{if ne .Page.SearchTerms "" }}
      <strong>{{.Page.ItemCount}}</strong> tag{{if gt .Page.ItemCount 1}}s{{end}} found
      {{else}}
      <strong>{{.Page.ItemCount}}</strong> tag{{if gt .Page.ItemCount 1}}s{{end}}
      {{end}}
    </p>
  </div>
  {{template "pagination" (dict "Page" .Page "HxTarget" "#tag-list-content")}}
</nav>
{{end}}
