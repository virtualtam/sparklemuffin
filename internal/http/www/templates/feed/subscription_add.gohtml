{{define "content"}}
<section class="pt-3">
  <nav aria-label="breadcrumb">
    <ol class="breadcrumb">
      <li class="breadcrumb-item"><a href="/feeds">Feeds</a></li>
      <li class="breadcrumb-item"><a href="/feeds/subscriptions">Subscriptions</a></li>
      <li class="breadcrumb-item active" aria-current="page">Add</li>
    </ol>
  </nav>

  <form action="/feeds/subscriptions/add" method="POST">
    <div class="row mb-3">
      <label class="col-sm-2 col-form-label" for="url">URL</label>
      <div class="col-sm-10">
        <input class="form-control" type="url" id="url" name="url" placeholder="URL" required="">
      </div>
    </div>

    <div class="row mb-3">
      <label class="col-sm-2 col-form-label" for="category">Category</label>
      <div class="col-sm-10">
        <select class="form-select" name="category" id="category">
          {{- range .}}
          <option value="{{.UUID}}">{{.Name}}</option>
          {{- end}}
        </select>
      </div>
    </div>

    <div class="row mb-3">
      <div class="col-sm-10 offset-sm-2">
        <button type="submit" class="btn btn-primary">Save</button>
      </div>
    </div>
  </form>
</section>
{{end}}
